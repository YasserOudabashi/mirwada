; Mirwada — configurazione di progetto
;
; Pixel art 32x32 su base 640x360 (20x11 tile abbondanti a schermo).
; La risoluzione e' una decisione irreversibile presa in CLAUDE.md:
; cambiarla dopo significa rifare ogni asset.

config_version=5

[application]

config/name="Mirwada"
config/description="Action-RPG 2D esplorativo con progressione a Pathway e Sequenze."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[autoload]

; Fonte unica dei dati. Deve stare prima di ogni sistema che li legge.
GameData="*res://scripts/game_data.gd"
AbilityEngine="*res://scripts/ability_engine.gd"

[display]

; Viewport logico: e' questa la risoluzione in cui si ragiona.
window/size/viewport_width=640
window/size/viewport_height=360
; Finestra reale all'avvio: 640x360 scalato x2, cosi' e' guardabile.
window/size/window_width_override=1280
window/size/window_height_override=720
; "viewport" rende a 640x360 e poi scala l'immagine intera: i pixel
; restano quadrati e nessun elemento si disallinea dalla griglia.
window/stretch/mode="viewport"
window/stretch/aspect="keep"

[input]

; WASD per posizione fisica (funziona anche su tastiere non-QWERTY),
; frecce come alternativa. Il movimento e' a 8 direzioni: le azioni sono
; i due assi, la diagonale nasce dalla somma. Vedi scripts/player.gd.
move_up={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":0,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":87,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":0,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194320,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
