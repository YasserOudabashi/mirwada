{
  "schema_version": 1,
  "id": "dlg_ottavia",
  "start": "n1",
  "_comment": "Archivista dell'ordine minore. Concede il flag testi_ordine_minore che apre l'Archivio Sepolto (US-611).",
  "nodes": {
    "n1": {
      "speaker": "npc_ottavia",
      "text": "L'Archivio non e' per curiosi. Cosa cerchi?",
      "text_i18n": "dialogue.ottavia.n1",
      "choices": [
        {
          "text": "Vorrei leggere i testi dell'ordine minore.",
          "text_i18n": "dialogue.ottavia.n1.chiedi",
          "condizioni": [
            {
              "tipo": "tier_min",
              "valore": "mid"
            }
          ],
          "effetti": [],
          "goto": "n2"
        },
        {
          "text": "So gia' abbastanza da meritarlo.",
          "text_i18n": "dialogue.ottavia.n1.insisti",
          "condizioni": [
            {
              "tipo": "flag",
              "valore": "sidon_ha_parlato"
            }
          ],
          "effetti": [],
          "goto": "n2"
        },
        {
          "text": "C'e' qualcosa che posso fare per l'Ordine?",
          "text_i18n": "dialogue.ottavia.n1.ordine",
          "condizioni": [
            {
              "tipo": "tier_min",
              "valore": "mid"
            },
            {
              "tipo": "flag",
              "valore": "testi_ordine_minore"
            }
          ],
          "effetti": [],
          "goto": "n3"
        },
        {
          "text": "Devo andare.",
          "text_i18n": "dialogue.ottavia.n1.congedo",
          "condizioni": [],
          "effetti": [],
          "goto": null
        }
      ]
    },
    "n2": {
      "speaker": "npc_ottavia",
      "text": "Forse. Prendi questo lasciapassare: le ali interne ti sono aperte.",
      "text_i18n": "dialogue.ottavia.n2",
      "choices": [
        {
          "text": "Grazie.",
          "text_i18n": "dialogue.ottavia.n2.accetta",
          "condizioni": [],
          "effetti": [
            {
              "tipo": "flag",
              "id": "testi_ordine_minore",
              "valore": true
            },
            {
              "tipo": "emit_event",
              "evento": "npc_influenced",
              "modo": "persuaso"
            },
            {
              "tipo": "impara_sinergia",
              "id": "anti_furia_e_calma"
            }
          ],
          "goto": null
        },
        {
          "text": "Devo andare.",
          "text_i18n": "dialogue.ottavia.n2.congedo",
          "condizioni": [],
          "effetti": [],
          "goto": null
        }
      ]
    },
    "n3": {
      "speaker": "npc_ottavia",
      "text": "Delle carte escono dall'Archivio di notte e finiscono al porto. Chi scarica le casse sa chi le compra. Riportamele, e l'Ordine se ne ricordera'.",
      "text_i18n": "dialogue.ottavia.n3",
      "choices": [
        {
          "text": "Le cerco io.",
          "text_i18n": "dialogue.ottavia.n3.accetta",
          "condizioni": [],
          "effetti": [
            {
              "tipo": "avvia_quest",
              "quest_id": "q_ottavia_02"
            }
          ],
          "goto": null
        },
        {
          "text": "Non adesso.",
          "text_i18n": "dialogue.ottavia.n3.congedo",
          "condizioni": [],
          "effetti": [],
          "goto": null
        }
      ]
    }
  }
}
