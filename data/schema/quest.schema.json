{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Una quest di data/quests/ (design-npc-quest cap. 6.3, US-616)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name_i18n", "giver", "atto", "fallibile", "exclusive_with", "steps", "ricompense"],
  "properties": {
    "schema_version": { "type": "integer" },
    "_comment": { "type": "string" },
    "id": { "type": "string", "pattern": "^q_" },
    "name_i18n": { "type": "string", "pattern": "^quest\\." },
    "name": { "type": "string" },
    "giver": { "type": "string", "pattern": "^npc_" },
    "atto": { "type": "integer", "minimum": 1, "maximum": 3 },
    "fallibile": { "type": "boolean" },
    "exclusive_with": { "type": "array", "items": { "type": "string" } },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "desc_i18n", "completamento", "on_complete"],
        "properties": {
          "id": { "type": "string" },
          "desc_i18n": { "type": "string", "pattern": "^quest\\." },
          "desc": { "type": "string" },
          "completamento": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["tipo", "evento", "target"],
                "properties": {
                  "tipo": { "const": "evento" },
                  "evento": { "type": "string" },
                  "filtri": { "type": "object" },
                  "target": { "type": "number", "exclusiveMinimum": 0 }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["tipo", "id"],
                "properties": {
                  "tipo": { "const": "flag" },
                  "id": { "type": "string" }
                }
              }
            ]
          },
          "on_complete": { "type": "array", "items": { "$ref": "#/definitions/effetto" } }
        }
      }
    },
    "ricompense": { "type": "array", "items": { "$ref": "#/definitions/effetto" } }
  },
  "definitions": {
    "effetto": {
      "type": "object",
      "required": ["tipo"],
      "properties": {
        "tipo": { "enum": ["flag", "item", "reputazione", "ancora", "apri_vendita"] }
      }
    }
  }
}
