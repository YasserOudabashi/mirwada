{
  "schema_version": 1,
  "id": "dlg_vesna",
  "start": "n1",
  "_comment": "Guaritrice ai margini. reputazione_min per la cura; usare poteri davanti a lei la raffredda (US-615).",
  "nodes": {
    "n1": {
      "speaker": "npc_vesna",
      "text": "Se sei ferito posso aiutarti. Se sei uno di loro, gira al largo.",
      "text_i18n": "dialogue.vesna.n1",
      "choices": [
        {
          "text": "Ho bisogno di cure.",
          "text_i18n": "dialogue.vesna.n1.cura",
          "condizioni": [
            {
              "tipo": "reputazione_min",
              "valore": [
                "quartiere",
                0
              ]
            }
          ],
          "effetti": [
            {
              "tipo": "emit_event",
              "evento": "npc_influenced",
              "modo": "aiutato"
            }
          ],
          "goto": "n2"
        },
        {
          "text": "Non sono una minaccia.",
          "text_i18n": "dialogue.vesna.n1.rassicura",
          "condizioni": [],
          "effetti": [
            {
              "tipo": "emit_event",
              "evento": "npc_influenced",
              "modo": "persuaso"
            },
            {
              "tipo": "flag",
              "id": "vesna_rassicurata",
              "valore": true
            },
            {
              "tipo": "avvia_quest",
              "quest_id": "q_vesna_01"
            }
          ],
          "goto": "n3"
        },
        {
          "text": "Vesna, devo dirti cosa sono diventato.",
          "text_i18n": "dialogue.vesna.n1.bivio",
          "condizioni": [
            {
              "tipo": "tier_min",
              "valore": "saint"
            },
            {
              "tipo": "flag_assente",
              "valore": "vesna_ha_scelto"
            }
          ],
          "effetti": [],
          "goto": "n4"
        },
        {
          "text": "Devo andare.",
          "text_i18n": "dialogue.vesna.n1.congedo",
          "condizioni": [],
          "effetti": [],
          "goto": null
        }
      ]
    },
    "n2": {
      "speaker": "npc_vesna",
      "text": "Tieni. E cerca di non tornare troppo presto.",
      "text_i18n": "dialogue.vesna.n2",
      "choices": [
        {
          "text": "Devo andare.",
          "text_i18n": "dialogue.vesna.n2.congedo",
          "condizioni": [],
          "effetti": [],
          "goto": null
        }
      ]
    },
    "n3": {
      "speaker": "npc_vesna",
      "text": "Lo dicono tutti. Poi cambiano.",
      "text_i18n": "dialogue.vesna.n3",
      "choices": [
        {
          "text": "Devo andare.",
          "text_i18n": "dialogue.vesna.n3.congedo",
          "condizioni": [],
          "effetti": [],
          "goto": null
        }
      ]
    },
    "n4": {
      "speaker": "npc_vesna",
      "text": "Lo vedo da sola. Ti ho ricucito quando sanguinavi come tutti; adesso le ferite ti si chiudono prima che io trovi l'ago. Dammi una ragione per non fare i bagagli stanotte.",
      "text_i18n": "dialogue.vesna.n4",
      "choices": [
        {
          "text": "Qui c'e' gente che ha bisogno di te. E io ho bisogno che qualcuno mi guardi come guardi i feriti.",
          "text_i18n": "dialogue.vesna.n4.resta",
          "condizioni": [],
          "effetti": [
            {
              "tipo": "flag",
              "id": "vesna_ha_scelto",
              "valore": true
            },
            {
              "tipo": "flag",
              "id": "vesna_resta",
              "valore": true
            },
            {
              "tipo": "reputazione",
              "faction_id": "quartiere",
              "delta": 15
            },
            {
              "tipo": "emit_event",
              "evento": "npc_influenced",
              "modo": "persuaso"
            }
          ],
          "goto": "n5"
        },
        {
          "text": "Non te la do. Vai, finche' puoi.",
          "text_i18n": "dialogue.vesna.n4.vai",
          "condizioni": [],
          "effetti": [
            {
              "tipo": "flag",
              "id": "vesna_ha_scelto",
              "valore": true
            },
            {
              "tipo": "flag",
              "id": "vesna_se_ne_va",
              "valore": true
            },
            {
              "tipo": "reputazione",
              "faction_id": "quartiere",
              "delta": -10
            },
            {
              "tipo": "emit_event",
              "evento": "npc_influenced",
              "modo": "intimidito"
            }
          ],
          "goto": "n6"
        }
      ]
    },
    "n5": {
      "speaker": "npc_vesna",
      "text": "Resto. Ma la porta la tengo aperta, e non per farti entrare.",
      "text_i18n": "dialogue.vesna.n5",
      "choices": [
        {
          "text": "Devo andare.",
          "text_i18n": "dialogue.vesna.n5.congedo",
          "condizioni": [],
          "effetti": [],
          "goto": null
        }
      ]
    },
    "n6": {
      "speaker": "npc_vesna",
      "text": "Almeno sei onesto. Il quartiere si arrangera'. Addio.",
      "text_i18n": "dialogue.vesna.n6",
      "choices": [
        {
          "text": "Devo andare.",
          "text_i18n": "dialogue.vesna.n6.congedo",
          "condizioni": [],
          "effetti": [],
          "goto": null
        }
      ]
    }
  }
