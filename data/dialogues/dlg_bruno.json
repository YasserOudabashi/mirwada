{
  "schema_version": 1,
  "id": "dlg_bruno",
  "start": "n1",
  "_comment": "Contrabbandiere del porto, solo di notte. Aiutarlo apre i passaggi notturni (gate npc, US-611).",
  "nodes": {
    "n1": {
      "speaker": "npc_bruno",
      "text": "Di giorno non ci siamo visti. Adesso, cosa vuoi?",
      "text_i18n": "dialogue.bruno.n1",
      "choices": [
        {
          "text": "Ti do una mano a spostare il carico.",
          "text_i18n": "dialogue.bruno.n1.aiuta",
          "condizioni": [
            {
              "tipo": "e_notte",
              "valore": true
            }
          ],
          "effetti": [
            {
              "tipo": "emit_event",
              "evento": "npc_influenced",
              "modo": "aiutato"
            },
            {
              "tipo": "flag",
              "id": "bruno_porto_notturno",
              "valore": true
            }
          ],
          "goto": "n2"
        },
        {
          "text": "Cerco delle carte uscite dall'Archivio.",
          "text_i18n": "dialogue.bruno.n1.carte",
          "condizioni": [
            {
              "tipo": "flag",
              "valore": "carte_porto_si_fida"
            }
          ],
          "effetti": [],
          "goto": "n3"
        },
        {
          "text": "Fammi vedere cosa hai.",
          "text_i18n": "dialogue.bruno.n1.merce",
          "condizioni": [],
          "effetti": [
            {
              "tipo": "apri_vendita",
              "npc_id": "npc_bruno"
            }
          ],
          "goto": null
        },
        {
          "text": "Devo andare.",
          "text_i18n": "dialogue.bruno.n1.congedo",
          "condizioni": [],
          "effetti": [],
          "goto": null
        }
      ]
    },
    "n2": {
      "speaker": "npc_bruno",
      "text": "Bravo. Adesso il molo di notte e' anche tuo. E la strada per le Marche.",
      "text_i18n": "dialogue.bruno.n2",
      "choices": [
        {
          "text": "Devo andare.",
          "text_i18n": "dialogue.bruno.n2.congedo",
          "condizioni": [],
          "effetti": [],
          "goto": null
        }
      ]
    },
    "n3": {
      "speaker": "npc_bruno",
      "text": "Le ho io. L'Ordine le chiude a chiave; io le faccio leggere a chi ne ha bisogno, e ci campa mezzo molo. Decidi tu dove vanno: ma poi si sapra' da che parte stai.",
      "text_i18n": "dialogue.bruno.n3",
      "choices": [
        {
          "text": "Tornano all'Archivio.",
          "text_i18n": "dialogue.bruno.n3.ordine",
          "condizioni": [],
          "effetti": [
            {
              "tipo": "flag",
              "id": "carte_all_ordine",
              "valore": true
            }
          ],
          "goto": "n4"
        },
        {
          "text": "Restano al porto. Ottavia non le rivedra'.",
          "text_i18n": "dialogue.bruno.n3.porto",
          "condizioni": [],
          "effetti": [
            {
              "tipo": "flag",
              "id": "carte_al_porto",
              "valore": true
            },
            {
              "tipo": "avvia_quest",
              "quest_id": "q_bruno_02"
            }
          ],
          "goto": "n5"
        },
        {
          "text": "Ci devo pensare.",
          "text_i18n": "dialogue.bruno.n3.congedo",
          "condizioni": [],
          "effetti": [],
          "goto": null
        }
      ]
    },
    "n4": {
      "speaker": "npc_bruno",
      "text": "Prendile. Il molo ha la memoria lunga, ricordatelo.",
      "text_i18n": "dialogue.bruno.n4",
      "choices": [
        {
          "text": "Devo andare.",
          "text_i18n": "dialogue.bruno.n4.congedo",
          "condizioni": [],
          "effetti": [],
          "goto": null
        }
      ]
    },
    "n5": {
      "speaker": "npc_bruno",
      "text": "Allora sei dei nostri. All'Archivio non farti vedere per un po'.",
      "text_i18n": "dialogue.bruno.n5",
      "choices": [
        {
          "text": "Devo andare.",
          "text_i18n": "dialogue.bruno.n5.congedo",
          "condizioni": [],
          "effetti": [],
          "goto": null
        }
      ]
    }
  }
}
