; Mirwada — configurazione di progetto
;
; Pixel art 32x32 su base 640x360 (20x11 tile abbondanti a schermo).
; La risoluzione e' una decisione irreversibile presa in CLAUDE.md:
; cambiarla dopo significa rifare ogni asset.

config_version=5

[application]

config/name="Mirwada"
config/description="Action-RPG 2D esplorativo con progressione a Pathway e Sequenze."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[autoload]

; Fonte unica dei dati. Deve stare prima di ogni sistema che li legge.
GameData="*res://scripts/game_data.gd"
Progression="*res://scripts/progression.gd"
EventTracker="*res://scripts/event_tracker.gd"
AbilityEngine="*res://scripts/ability_engine.gd"
SaveSystem="*res://scripts/save_system.gd"
GameState="*res://scripts/game_state.gd"
WorldState="*res://scripts/world_state.gd"
SummonRegistry="*res://scripts/summon_registry.gd"
CharacteristicStore="*res://scripts/characteristic_store.gd"
Inventory="*res://scripts/inventory.gd"
Equipment="*res://scripts/equipment.gd"
Madness="*res://scripts/madness.gd"
Foundation="*res://scripts/foundation.gd"
Acting="*res://scripts/acting.gd"
PotionSystem="*res://scripts/potion_system.gd"
Forge="*res://scripts/forge.gd"
AudioManager="*res://scripts/audio_manager.gd"
AnchorSystem="*res://scripts/anchor_system.gd"
RitualSystem="*res://scripts/ritual_system.gd"
PerceptionSystem="*res://scripts/perception_system.gd"
KnowledgeStore="*res://scripts/knowledge_store.gd"
SettingsStore="*res://scripts/settings_store.gd"
Vfx="*res://scripts/vfx.gd"
Book="*res://scripts/book.gd"

[display]

; Viewport logico: e' questa la risoluzione in cui si ragiona.
window/size/viewport_width=640
window/size/viewport_height=360
; Finestra reale all'avvio: 640x360 scalato x2, cosi' e' guardabile.
window/size/window_width_override=1280
window/size/window_height_override=720
; "viewport" rende a 640x360 e poi scala l'immagine intera: i pixel
; restano quadrati e nessun elemento si disallinea dalla griglia.
window/stretch/mode="viewport"
window/stretch/aspect="keep"

[internationalization]

; i18n dal giorno 1 (CLAUDE.md): nessun testo hardcoded, nemmeno nell'HUD.
; Le stringhe vivono in assets/i18n/strings.csv -> .translation generati.
locale/translations=PackedStringArray("res://assets/i18n/strings.en.translation", "res://assets/i18n/strings.it.translation")
locale/fallback="it"

[input]

; WASD per posizione fisica (funziona anche su tastiere non-QWERTY),
; frecce come alternativa. Il movimento e' a 8 direzioni: le azioni sono
; i due assi, la diagonale nasce dalla somma. Vedi scripts/player.gd.
